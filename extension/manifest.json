{
  "manifest_version": 3,
  "name": "SecurePrompt Security Gateway",
  "version": "1.0.0",
  "description": "Shadow AI Leak Detector - Scans prompt text for PII/Secrets, displays warnings, and provides privacy-safe LLM rewrites.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
